{
  "name": "PRORASTRO - Emissao NFSe Belem",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "asaas-nfse-prorastro",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-asaas-nfse",
      "name": "🔔 Webhook Asaas (Pagamento)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, 320],
      "webhookId": "asaas-nfse-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "ASAAS_API_URL", "value": "https://api.asaas.com/v3", "type": "string" },
            { "id": "c2", "name": "ASAAS_API_KEY", "value": "={{ $env.ASAAS_API_KEY }}", "type": "string" },
            { "id": "c3", "name": "NFSE_SIGNER_URL", "value": "http://nfse-signer:3005", "type": "string" },
            { "id": "c4", "name": "NFSE_SIGNER_TOKEN", "value": "={{ $env.NFSE_SIGNER_TOKEN }}", "type": "string" },
            { "id": "c5", "name": "TP_AMB", "value": 2, "type": "number" },
            { "id": "c6", "name": "EVOLUTION_API_URL", "value": "https://evoapi.santzap.com.br", "type": "string" },
            { "id": "c7", "name": "EVOLUTION_INSTANCE", "value": "PRORASTRO-ATENDIMENTO", "type": "string" },
            { "id": "c8", "name": "EVOLUTION_API_KEY", "value": "={{ $env.EVOLUTION_API_KEY }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "cfg",
      "name": "⚙️ Config (use env/credentials)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-960, 320],
      "notes": "NAO cole chaves aqui. Use variaveis de ambiente do n8n ($env) ou Credentials."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "or",
          "conditions": [
            { "id": "e1", "leftValue": "={{ $json.body.event }}", "rightValue": "PAYMENT_RECEIVED", "operator": { "type": "string", "operation": "equals" } },
            { "id": "e2", "leftValue": "={{ $json.body.event }}", "rightValue": "PAYMENT_CONFIRMED", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "filtro-evento",
      "name": "É pagamento confirmado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-720, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('⚙️ Config (use env/credentials)').item.json.ASAAS_API_URL }}/customers/{{ $json.body.payment.customer }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $('⚙️ Config (use env/credentials)').item.json.ASAAS_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "get-cliente",
      "name": "Buscar Cliente (Asaas)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-480, 240]
    },
    {
      "parameters": {
        "jsCode": "// Monta o payload da nota a partir do pagamento + cliente do Asaas.\nconst pay = $('🔔 Webhook Asaas (Pagamento)').first().json.body.payment;\nconst cli = $('Buscar Cliente (Asaas)').first().json;\nconst cfg = $('⚙️ Config (use env/credentials)').first().json;\n\n// documento do tomador (CPF ou CNPJ)\nconst doc = (cli.cpfCnpj || '').replace(/\\D/g, '');\nconst tomador = { xNome: cli.name || cli.company || 'Consumidor' };\nif (doc.length === 14) tomador.cnpj = doc; else if (doc.length === 11) tomador.cpf = doc;\nif (cli.email) tomador.email = cli.email;\nif (cli.postalCode && cli.address) {\n  tomador.endereco = {\n    cMun: '1501402', // TODO: mapear cidade do cliente -> codigo IBGE (aqui fixo Belem)\n    cep: (cli.postalCode || '').replace(/\\D/g, ''),\n    logradouro: cli.address,\n    numero: cli.addressNumber || 'S/N',\n    complemento: cli.complement || undefined,\n    bairro: cli.province || 'Centro'\n  };\n}\n\nreturn [{ json: {\n  nDPS: Number(String(pay.id).replace(/\\D/g, '').slice(-9)) || Date.now() % 1000000000, // sequencial simples; ver nota\n  vServ: pay.value,\n  tpAmb: cfg.TP_AMB,\n  paymentId: pay.id,\n  xDescServ: `Rastreamento veicular - ref. cobranca ${pay.invoiceNumber || pay.id}`,\n  tomador\n} }];"
      },
      "id": "montar-payload",
      "name": "Montar dados da nota",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config (use env/credentials)').item.json.NFSE_SIGNER_URL }}/emitir-nota",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-token", "value": "={{ $('⚙️ Config (use env/credentials)').item.json.NFSE_SIGNER_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "emitir",
      "name": "Emitir NFS-e (microserviço)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "ok1", "leftValue": "={{ $json.chaveAcesso }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "emitiu-ok",
      "name": "Emitiu com sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_API_URL }}/message/sendText/{{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Buscar Cliente (Asaas)').item.json.mobilePhone || $('Buscar Cliente (Asaas)').item.json.phone }}\",\n  \"text\": \"✅ Sua nota fiscal foi emitida!\\nChave: {{ $json.chaveAcesso }}\\nObrigado por ser cliente PRORASTRO.\"\n}",
        "options": {}
      },
      "id": "whatsapp-ok",
      "name": "WhatsApp: nota emitida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_API_URL }}/message/sendText/{{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('⚙️ Config (use env/credentials)').item.json.EVOLUTION_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"5591991837470\",\n  \"text\": \"⚠️ Falha ao emitir NFS-e (pagamento {{ $('Montar dados da nota').item.json.paymentId }}).\\nResposta: {{ JSON.stringify($json).slice(0,300) }}\"\n}",
        "options": {}
      },
      "id": "whatsapp-erro",
      "name": "Alerta: falha emissão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 360]
    },
    {
      "parameters": { "respondWith": "text", "responseBody": "OK", "options": {} },
      "id": "resp",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-720, 520]
    }
  ],
  "connections": {
    "🔔 Webhook Asaas (Pagamento)": { "main": [[{ "node": "⚙️ Config (use env/credentials)", "type": "main", "index": 0 }]] },
    "⚙️ Config (use env/credentials)": { "main": [[{ "node": "É pagamento confirmado?", "type": "main", "index": 0 }]] },
    "É pagamento confirmado?": { "main": [[{ "node": "Buscar Cliente (Asaas)", "type": "main", "index": 0 }], [{ "node": "Responder 200", "type": "main", "index": 0 }]] },
    "Buscar Cliente (Asaas)": { "main": [[{ "node": "Montar dados da nota", "type": "main", "index": 0 }]] },
    "Montar dados da nota": { "main": [[{ "node": "Emitir NFS-e (microserviço)", "type": "main", "index": 0 }]] },
    "Emitir NFS-e (microserviço)": { "main": [[{ "node": "Emitiu com sucesso?", "type": "main", "index": 0 }]] },
    "Emitiu com sucesso?": { "main": [[{ "node": "WhatsApp: nota emitida", "type": "main", "index": 0 }], [{ "node": "Alerta: falha emissão", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
